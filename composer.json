{
    "name": "dalpras/form-zero",
    "description": "Yet another kind of forms: without the need of a view, low dependencies, rendering by decorators",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": ">=8.4.1",
        "dalpras/smart-template": "^5.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "symfony/http-foundation": "^8.1",
        "symfony/validator": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3.6"
    },
    "autoload": {
        "psr-4": {
            "DalPraS\\FormZero\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DalPraS\\UnitTests\\": "tests/UnitTests/"
        }
    },
    "authors": [
        {
            "name": "Stefano Dal Prà"
        }
    ],
	"config": {
		"vendor-dir": "vendor",
		"allow-plugins": {
			"php-http/discovery": true
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "../smart-template",
			"options": {
				"symlink": true
			},
            "canonical": false
		}
	],    
    "scripts": {
        "test": "phpunit tests"
    },    
	"minimum-stability" : "dev",
	"prefer-stable" : true
}
